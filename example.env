# Ссылка на поиск вакансий
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# OpenAI-compatible API
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# Безопасный режим включён по умолчанию. Для реальных записей требуется явно указать false.
HH_DRY_RUN=true

# Независимые разрешения на действия (в dry-run записи всё равно блокируются)
HH_AUTO_APPLY=true
HH_AUTO_CHAT=true
HH_AUTO_TOUCH=true
HH_AUTO_JOB_STATUS=true

# Чаты: off, review (без отправки) или auto. По умолчанию review.
HH_CHAT_MODE=review

# Vacancy relevance filters
HH_MIN_SALARY=
HH_MIN_SALARY_CURRENCY=RUR
HH_INCLUDE_KEYWORDS=Python,Django,REST API
HH_EXCLUDE_KEYWORDS=1С,PHP Senior,DevOps Senior
HH_MIN_MATCH_SCORE=65

# Safe first pass: one cycle and then exit. 0 means unlimited for the caps.
HH_RUN_ONCE=false
HH_MAX_VACANCIES_PER_RUN=20
HH_MAX_APPLICATIONS_PER_RUN=10

# Не заполняйте, если ссылку на GitHub не нужно сообщать работодателю.
HH_GITHUB_URL=
