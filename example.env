# Один URL поиска вакансий (fallback для HH_SEARCH_URLS)
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# Несколько профилей через ||. area/resume можно задать отдельно в каждом URL.
# Для каждого URL приложение сохраняет query-параметры и добавляет:
# order_by=publication_time, search_period=7, items_on_page=50
HH_SEARCH_URLS=
HH_SEARCH_PERIOD_DAYS=7
HH_MAX_SEARCH_PROFILES=16
# Positive read-only discovery bounds; a truncated run is incomplete.
HH_MAX_SEARCH_PAGES_PER_PROFILE=3
HH_MAX_SEARCH_PAGES_PER_RUN=48

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# Playwright browser transport for HH web reads. auto selects browser on hh.ru
# when cookies.txt exists; http is kept only for local fixtures/compatibility.
HH_BROWSER_TRANSPORT=auto
HH_BROWSER_HEADLESS=false
# Legacy compatibility option; no authenticated data is stored in this profile.
HH_BROWSER_PROFILE=.hh-browser-profile
# Optional one-vacancy URL for the browser-vs-HTTP read trace.
HH_BROWSER_TRACE_VACANCY=

# HH read transport selection. This is independent from HH_BROWSER_TRANSPORT,
# which continues to select the compatibility browser implementation details.
HH_TRANSPORT=browser
HH_API_BASE_URL=https://api.hh.ru
HH_OAUTH_AUTHORIZE_URL=https://hh.ru/oauth/authorize
HH_OAUTH_TOKEN_URL=https://api.hh.ru/token
HH_OAUTH_CLIENT_ID=
HH_OAUTH_CLIENT_SECRET=
HH_OAUTH_REDIRECT_URI=
HH_OAUTH_USER_AGENT=
HH_API_TOKEN_FILE=.hh-api-token.json

# Chat / completion (independent from semantic embeddings)
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# Semantic embeddings. Set EMBEDDING_PROVIDER explicitly to enable semantic
# retrieval/indexing. If endpoint/key are empty, the HH_AI_* values are used
# only as a compatibility fallback.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Безопасный режим включён по умолчанию. Для реальных записей требуется явно указать false.
HH_DRY_RUN=true

# Отдельный шлюз ручной отправки ответов/follow-up. По умолчанию выключен.
HH_WRITE_ENABLED=false
HH_CHAT_URL=https://chatik.hh.ru
HH_MAX_WRITES_PER_RUN=1
HH_MAX_WRITES_PER_DAY=5

# Независимые разрешения на действия (в dry-run записи всё равно блокируются)
HH_AUTO_APPLY=true
HH_AUTO_CHAT=true
HH_AUTO_TOUCH=true
HH_AUTO_JOB_STATUS=true

# Чаты: off, review (без отправки) или auto. По умолчанию review.
HH_CHAT_MODE=review

# Vacancy relevance filters
HH_MIN_SALARY=
HH_MIN_SALARY_CURRENCY=RUR
HH_INCLUDE_KEYWORDS=Python,Django,REST API
HH_EXCLUDE_KEYWORDS=1С,PHP Senior,DevOps Senior
HH_MIN_MATCH_SCORE=65

# Safe first pass: one cycle and then exit. 0 means unlimited for the caps.
HH_RUN_ONCE=false
HH_MAX_VACANCIES_PER_RUN=50
HH_MAX_APPLICATIONS_PER_RUN=10
# Career monitor one-run only; 0 preserves the normal full-scope behavior.
HH_MAX_CONVERSATIONS_PER_RUN=0

# Локальный state только для подтверждённых preflight already_responded=true.
HH_ALREADY_RESPONDED_STATE=.hh-already-responded.json
HH_SYNC_STATE=hh_sync_state.json
HH_SYNC_INTERVAL=15m
HH_QUIET_HOURS=
HH_NOTIFICATION_COOLDOWN=15m
HH_CONVERSATION_DISPLAY_TTL=60s
HH_BACKGROUND_INBOX_REFRESH=false
HH_CANDIDATE_PROFILE=candidate_profile.json
HH_CANDIDATE_ID=candidate-local
# Необязательные примеры опыта для релевантных сопроводительных писем.
HH_CANDIDATE_STORIES=candidate_stories.json
HH_RESUME_REGISTRY=resume_registry.json
HH_CAREER_AGENT_RESULT=career_agent_latest.json
HH_CAREER_AGENT_FEEDBACK=career_agent_feedback.json
HH_CAREER_AGENT_WORKFLOW=career_agent_workflow.json

# Read-only daily Career Agent: `career-agent daily` or dashboard Run daily.
# The daily workflow always forces dry-run and never receives HH write capability.
HH_CAREER_AGENT_DAILY_ENABLED=false
HH_CAREER_AGENT_DAILY_INTERVAL=24h

# Canary is opt-in through `career-agent --canary`; this value never enables
# writes by itself. Supported values: off, canary.
HH_AUTO_APPLY_MODE=off

# VacancyRepository backend. JSON is the safe default; PostgreSQL is opt-in.
STORAGE_BACKEND=json
DATABASE_URL=

# Оценка: неизвестные обязательные требования дают vacancy_review_required,
# а не автоматический отклик. Неизвестный response count не подставляется в события.

# Не заполняйте, если ссылку на GitHub не нужно сообщать работодателю.
HH_GITHUB_URL=

# Career Agent Dashboard: ./hh-ai-responder web
# Локальный read-only интерфейс HH. Только loopback; CLI --host/--port важнее env.
HH_WEB_HOST=127.0.0.1
HH_WEB_PORT=8080

# Follow-up eligibility only: no background timers or HH sends.
HH_FOLLOW_UP_AFTER_APPLICATION=120h
HH_FOLLOW_UP_AFTER_MESSAGE=72h
HH_FOLLOW_UP_MAX=2
HH_FOLLOW_UP_MINIMUM_INTERVAL=72h

# Stage 22: bounded independent HH reads (1..8). CLI --hh-read-concurrency wins.
# The existing request interval still applies; writes are never parallelized.
HH_READ_CONCURRENCY=4
